port 1199
proto udp
dev tun90
server 10.10.90.0 255.255.255.0
key-direction 0

auth md_gost12_256
cipher kuznyechik-cbc
data-ciphers kuznyechik-cbc:kuznyechik-ofb:kuznyechik-cfb
tls-ciphersuites TLS_GOSTR341112_256_WITH_KUZNYECHIK_MGM_S:TLS_GOSTR341112_256_WITH_KUZNYECHIK_MGM_L:TLS_GOSTR341112_256_WITH_MAGMA_MGM_S:TLS_GOSTR341112_256_WITH_MAGMA_MGM_L

user nobody
group nobody
verb 4
mute 0
max-clients 100

#
# this line is for linux:
# management /var/run/openvpn-server/gost-server.sock unix
#

keepalive 10 120
persist-key
persist-tun
topology subnet

tls-server
scramble obfuscate 1+J6cTC73l9KE8weqtRGIG4VIXAXHOa+

#push "redirect-gateway def1 bypass-dhcp"
#push "dhcp-option DNS 1.1.1.1"
#push "dhcp-option DNS 8.8.4.4"

